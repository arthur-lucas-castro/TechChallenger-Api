  "item": [
    {
      "name": "00 - Saúde",
      "item": [
        {
          "name": "Healthcheck pelo gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('gateway envia x-correlation-id e a API devolve', () => pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('correlationIdHealth', pm.response.headers.get('x-correlation-id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Versão da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Versao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Versao"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('retorna versão', () => pm.expect(pm.response.json().versao).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
