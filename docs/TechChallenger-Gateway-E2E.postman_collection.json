              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente\",\n  \"sobrenome\": \"Teste E2E\",\n  \"telefone\": \"11987654321\",\n  \"email\": \"{{clienteEmail}}\",\n  \"numeroDocumento\": \"{{clienteCpf}}\",\n  \"tipoPessoa\": \"F\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (base) => { const s = base.reduce((a, d, i) => a + d * (base.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.collectionVariables.set('clienteCpf', n.join(''));",
                  "pm.collectionVariables.set('clienteEmail', `e2e.${Date.now()}@oficina.test`);"
                ]
