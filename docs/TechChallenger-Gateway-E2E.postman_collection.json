        {
          "name": "Auth por CPF sem cadastro (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfGerado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (base) => { const s = base.reduce((a, d, i) => a + d * (base.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.variables.set('cpfGerado', n.join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.expect(pm.response.code).to.be.oneOf([404]));",
                  "pm.test('código CLIENTE_NAO_ENCONTRADO', () => pm.expect(pm.response.json().code).to.eql('CLIENTE_NAO_ENCONTRADO'));"
                ]
              }
            }
          ]
        }
